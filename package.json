{
  "name": "millq",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --parallel --filter @millq/api --filter @millq/web run dev",
    "dev:api": "pnpm --filter @millq/api run dev",
    "dev:web": "pnpm --filter @millq/web run dev",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm --filter @millq/domain --filter @millq/contracts run build && pnpm -r run typecheck",
    "preview:reset": "pnpm --filter @millq/api run preview:reset"
  }
}
